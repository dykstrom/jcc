call println(ceil(3.3))
call println(ceil(3.3f32))
call println(floor(3.7))
call println(floor(3.7f32))
call println(round(3.5))
call println(round(3.5f32))
call println(sqrt(2.0))
call println(sqrt(2f32))
call println(trunc(3.7))
call println(trunc(3.7f32))

call println(abs(-17))
call println(abs(-17i32))
call println(abs(-5.3))
call println(abs(-5.3f32))
call println(min(3, 9))
call println(min(3i32, 9i32))
call println(min(-0.3, -0.7))
call println(max(3.88f32, 3.87f32))

call println(f32(2))
call println(f64(2))
call println(i32(3.8))
call println(i64(3.8))
