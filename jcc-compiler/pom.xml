<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>se.dykstrom.jcc</groupId>
        <artifactId>jcc-parent</artifactId>
        <version>0.10.1-SNAPSHOT</version>
    </parent>

    <artifactId>jcc-compiler</artifactId>

    <profiles>
        <!-- Windows x86_64 -->
        <profile>
            <id>windows-x86_64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <native.classifier>windows-x86_64</native.classifier>
                <native.archive.type>zip</native.archive.type>
            </properties>
        </profile>
        <!-- Windows ARM64 -->
        <profile>
            <id>windows-arm64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.classifier>windows-arm64</native.classifier>
                <native.archive.type>zip</native.archive.type>
            </properties>
        </profile>
        <!-- macOS x86_64 -->
        <profile>
            <id>macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <native.classifier>macos-x86_64</native.classifier>
                <native.archive.type>tar.gz</native.archive.type>
            </properties>
        </profile>
        <!-- macOS ARM64 -->
        <profile>
            <id>macos-arm64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.classifier>macos-arm64</native.classifier>
                <native.archive.type>tar.gz</native.archive.type>
            </properties>
        </profile>
        <!-- Linux x86_64 -->
        <profile>
            <id>linux-x86_64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <native.classifier>linux-x86_64</native.classifier>
                <native.archive.type>tar.gz</native.archive.type>
            </properties>
        </profile>
        <!-- Linux ARM64 -->
        <profile>
            <id>linux-arm64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.classifier>linux-arm64</native.classifier>
                <native.archive.type>tar.gz</native.archive.type>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <artifactId>kotlin-maven-plugin</artifactId>
                <groupId>org.jetbrains.kotlin</groupId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.9.0</version>
                <executions>
                    <execution>
                        <id>download-native-libs</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://github.com/dykstrom/libjccbas/releases/download/v${libjccbas.version}/libjccbas-${libjccbas.version}-${native.classifier}.${native.archive.type}</url>
                            <outputDirectory>${project.build.directory}/native-libs</outputDirectory>
                            <outputFileName>libjccbas-${native.classifier}.${native.archive.type}</outputFileName>
                            <skipCache>false</skipCache>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>unpack-native-libs</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <taskdef resource="net/sf/antcontrib/antlib.xml"
                                         classpath="${maven.plugin.classpath}"/>
                                <!-- Check if library already exists in target directory -->
                                <available file="${project.build.directory}/libjccbas.a" property="lib.a.exists"/>
                                <available file="${project.build.directory}/libjccbas.dll" property="lib.dll.exists"/>
                                <condition property="lib.exists">
                                    <or>
                                        <isset property="lib.a.exists"/>
                                        <isset property="lib.dll.exists"/>
                                    </or>
                                </condition>
                                <!-- Only extract if library doesn't exist -->
                                <if>
                                    <not><isset property="lib.exists"/></not>
                                    <then>
                                        <echo message="Extracting native libraries for ${native.classifier}"/>
                                        <mkdir dir="${project.build.directory}/temp-extract"/>
                                        <if>
                                            <equals arg1="${native.archive.type}" arg2="zip"/>
                                            <then>
                                                <unzip src="${project.build.directory}/native-libs/libjccbas-${native.classifier}.zip"
                                                       dest="${project.build.directory}/temp-extract"/>
                                            </then>
                                            <else>
                                                <untar src="${project.build.directory}/native-libs/libjccbas-${native.classifier}.tar.gz"
                                                       dest="${project.build.directory}/temp-extract" compression="gzip"/>
                                            </else>
                                        </if>
                                        <!-- Copy library files to target root for integration tests -->
                                        <copy todir="${project.build.directory}" flatten="true">
                                            <fileset dir="${project.build.directory}/temp-extract">
                                                <include name="**/libjccbas.*"/>
                                            </fileset>
                                        </copy>
                                    </then>
                                    <else>
                                        <echo message="Native libraries already extracted, skipping"/>
                                    </else>
                                </if>
                            </target>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>ant-contrib</groupId>
                        <artifactId>ant-contrib</artifactId>
                        <version>1.0b3</version>
                        <exclusions>
                            <exclusion>
                                <groupId>ant</groupId>
                                <artifactId>ant</artifactId>
                            </exclusion>
                        </exclusions>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <mainClass>se.dykstrom.jcc.main.Jcc</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>assembly/bin.xml</descriptor>
                    </descriptors>
                    <archive>
                        <manifest>
                            <mainClass>se.dykstrom.jcc.main.Jcc</mainClass>
                        </manifest>
                    </archive>
                    <finalName>jcc-${project.version}</finalName>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/scripts</directory>
                <targetPath>../bin</targetPath>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/examples</directory>
                <targetPath>../examples</targetPath>
                <filtering>false</filtering>
            </resource>
            <!-- Copy native libraries to bin directory for distribution -->
            <resource>
                <directory>${project.build.directory}</directory>
                <targetPath>../bin</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>libjccbas.a</include>
                    <include>libjccbas.dll</include>
                </includes>
            </resource>
        </resources>
    </build>

    <dependencies>
        <dependency>
            <groupId>se.dykstrom.jcc</groupId>
            <artifactId>jcc-assembunny</artifactId>
        </dependency>
        <dependency>
            <groupId>se.dykstrom.jcc</groupId>
            <artifactId>jcc-base</artifactId>
        </dependency>
        <dependency>
            <groupId>se.dykstrom.jcc</groupId>
            <artifactId>jcc-basic</artifactId>
        </dependency>
        <dependency>
            <groupId>se.dykstrom.jcc</groupId>
            <artifactId>jcc-col</artifactId>
        </dependency>
        <dependency>
            <groupId>se.dykstrom.jcc</groupId>
            <artifactId>jcc-llvm</artifactId>
        </dependency>
        <dependency>
            <groupId>se.dykstrom.jcc</groupId>
            <artifactId>jcc-tiny</artifactId>
        </dependency>
        <dependency>
            <groupId>com.beust</groupId>
            <artifactId>jcommander</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.stefanbirkner</groupId>
            <artifactId>system-lambda</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
